# Sonne pour que GitHub lance ses workflows, qu'il oublie souvent de lancer
# lui-meme. Voir src/reveil.py pour la mesure et le raisonnement.
#
# Installe par deploiement/installer_serveur.sh, en meme temps que le bot.

[Unit]
Description=Reveil des workflows GitHub de l'EDT STRI
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/edt_stri
ExecStart=/opt/edt_stri/venv/bin/python -u /opt/edt_stri/src/reveil.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=TZ=Europe/Paris
